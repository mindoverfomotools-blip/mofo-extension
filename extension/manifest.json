{
  "manifest_version": 3,
  "name": "Mind Over Fomo, Mofo, your personal copilot",
  "version": "0.9.2",
  "description": "Mind over fomo. Chart copilot for fomo.family: entry heat, Gaussian channel, your plan on the chart, holder checks. Never trades.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MOFO",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "icons/orb.png"
      ],
      "matches": [
        "https://fomo.family/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "src/net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "src/engine.js",
        "src/tv.js",
        "src/panel.js",
        "src/overlay.js",
        "src/score-model.js",
        "src/fomo-trades.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
